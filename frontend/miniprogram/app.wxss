/* 鲜达超市 · 全局样式 */
page {
  background: #F6F8F6;
  color: #1F2D24;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ---------- 我的 ---------- */
.profile {
  display: flex;
  align-items: center;
  padding: 44rpx 32rpx 56rpx;
  background: linear-gradient(135deg, #2E9E5B, #4CB977);
}
.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  margin-right: 24rpx;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  overflow-y: auto;
  box-sizing: border-box;
}

/* ---------- 商品详情 ---------- */
.hero {
  width: 100%;
  height: 520rpx;
  display: block;
  background: #F1F5F2;
}

/* ---------- 通用布局 ---------- */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 45, 36, 0.05);
}

.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.muted { color: #7A8B80; font-size: 24rpx; }
.bold { font-weight: 600; }
.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }

/* ---------- 门店条 ---------- */
.store-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #2E9E5B, #4CB977);
  color: #fff;
}
.store-name { font-size: 32rpx; font-weight: 600; }
.store-status {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.22);
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
}

/* ---------- 类目 ---------- */
.cat-scroll { white-space: nowrap; padding: 20rpx 16rpx 4rpx; }
.cat-item {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin: 0 8rpx;
  border-radius: 100rpx;
  background: #fff;
  color: #5E6F64;
  font-size: 26rpx;
}
.cat-item.active {
  background: #2E9E5B;
  color: #fff;
  font-weight: 600;
}

/* ---------- 商品网格 ---------- */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 16rpx;
}
.goods-card {
  width: calc(50% - 32rpx);
  margin: 8rpx 8rpx 16rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(31, 45, 36, 0.05);
}
.goods-img { width: 100%; height: 300rpx; background: #F1F5F2; display: block; }
.goods-body { padding: 16rpx 18rpx 20rpx; }
.goods-name { font-size: 28rpx; font-weight: 600; line-height: 1.35; }
.goods-desc {
  font-size: 22rpx;
  color: #8A9A90;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}
.price { color: #FF7A45; font-weight: 700; font-size: 32rpx; }
.price-s { color: #FF7A45; font-weight: 700; font-size: 26rpx; }
.stock-tip { font-size: 20rpx; color: #FF7A45; margin-top: 6rpx; }
.add-btn.disabled {
  width: 96rpx;
  border-radius: 100rpx;
  background: #E7EEE9;
  color: #8A9A90;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 52rpx;
}
.unit { font-size: 22rpx; color: #A6B4AA; }

.add-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #2E9E5B;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}

/* ---------- 底部购物车条 ---------- */
.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  height: 104rpx;
  background: #1F2D24;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 0 36rpx;
  box-shadow: 0 10rpx 30rpx rgba(31, 45, 36, 0.25);
  z-index: 20;
}
.cart-bar-total { color: #fff; font-size: 30rpx; font-weight: 600; }
.cart-bar-sub { color: #9FB3A6; font-size: 22rpx; }
.cart-bar-btn {
  background: #2E9E5B;
  color: #fff;
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 100rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
}
.btn-primary { background: #2E9E5B; color: #fff; font-weight: 600; }
.btn-ghost { background: #fff; color: #2E9E5B; border: 2rpx solid #CFE8D8; }
.btn-plain { background: #F1F5F2; color: #5E6F64; }
.btn-sm { padding: 12rpx 28rpx; font-size: 24rpx; }

/* ---------- 规格 ---------- */
.spec-chips { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.chip {
  padding: 12rpx 30rpx;
  border-radius: 100rpx;
  background: #F1F5F2;
  color: #5E6F64;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
}
.chip.active { background: #EAF6EE; color: #2E9E5B; border: 2rpx solid #2E9E5B; font-weight: 600; }

/* ---------- 表单 ---------- */
.form-item { margin-top: 24rpx; }
.form-label { font-size: 24rpx; color: #7A8B80; }
.input {
  margin-top: 10rpx;
  background: #F6F8F6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.picker-value {
  background: #F6F8F6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1F2D24;
}

/* ---------- 状态 ---------- */
.tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
  background: #F1F5F2;
  color: #5E6F64;
}
.tag-green { background: #EAF6EE; color: #2E9E5B; }
.tag-orange { background: #FFF1E8; color: #FF7A45; }
.tag-gray { background: #F1F3F2; color: #8A9A90; }

.empty {
  text-align: center;
  color: #A6B4AA;
  padding: 160rpx 0;
  font-size: 28rpx;
}
.empty-img { width: 200rpx; height: 200rpx; opacity: 0.55; margin-bottom: 24rpx; }

/* ---------- 订单 ---------- */
.tab-row {
  display: flex;
  background: #fff;
  padding: 8rpx 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #7A8B80;
  position: relative;
}
.tab-item.active { color: #2E9E5B; font-weight: 700; }
.tab-item.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 40rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #2E9E5B;
  transform: translateX(-50%);
}

.order-card { background: #fff; border-radius: 24rpx; margin: 20rpx 24rpx; padding: 24rpx; }
.order-goods { display: flex; margin-top: 20rpx; }
.order-goods-img { width: 112rpx; height: 112rpx; border-radius: 16rpx; background: #F1F5F2; margin-right: 20rpx; }
.order-actions { display: flex; justify-content: flex-end; margin-top: 20rpx; }
.order-actions .btn { margin-left: 16rpx; }

/* ---------- 结算 ---------- */
.total-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -6rpx 20rpx rgba(31, 45, 36, 0.06);
}
