// 订单列表结构
<view class="page">
  <view class="tab-row">
    <view
      wx:for="{{tabs}}"
      wx:key="label"
      class="tab-item {{activeTab === item.value ? 'active' : ''}}"
      data-value="{{item.value}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{orders.length}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <view class="between" bindtap="goDetail" data-id="{{item.id}}">
        <view class="muted">{{item.orderTime}}</view>
        <view class="tag {{item.statusTag}}">{{item.statusText}}</view>
      </view>

      <view class="between mt16">
        <view class="bold">单号 {{item.number}}</view>
        <view class="price-s">¥{{item.amountText}}</view>
      </view>

      <view class="muted mt8">共 {{item.items.length}} 件 · {{item.productSummary}}</view>

      <view class="order-actions">
        <view
          wx:if="{{item.status === 1}}"
          class="btn btn-primary btn-sm"
          data-index="{{index}}"
          catchtap="onPay"
        >去支付</view>
        <view
          wx:if="{{item.status === 1 || item.status === 2}}"
          class="btn btn-plain btn-sm"
          data-id="{{item.id}}"
          catchtap="onCancel"
        >取消</view>
        <view
          wx:if="{{item.status >= 2 && item.status <= 4}}"
          class="btn btn-ghost btn-sm"
          data-id="{{item.id}}"
          catchtap="onReminder"
        >催单</view>
        <view
          wx:if="{{item.status === 5 || item.status === 6}}"
          class="btn btn-ghost btn-sm"
          data-id="{{item.id}}"
          catchtap="onRepeat"
        >再来一单</view>
      </view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="empty">
    <image class="empty-img" src="/static/icons/fruit.png" mode="aspectFit" />
    <view>还没有订单</view>
    <view class="btn btn-ghost mt24" style="display:inline-block;" bindtap="goIndex">去逛逛</view>
  </view>
</view>
